# Mock mode does not require an API key.
MODEL_PROVIDER=mock
MODEL_BASE_URL=
MODEL_API_KEY_ENV=
MODEL_NAME=mock-order-model
MODEL_TIMEOUT_SECONDS=10

# Ollama example: use http://localhost:11434/v1 and leave API key env empty.
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY_ENV=
# MODEL_NAME=qwen3:1.7b
# MODEL_TIMEOUT_SECONDS=180

# Optional secondary OpenAI-compatible endpoint. Keep disabled in Mock mode.
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_API_KEY_ENV=
MODEL_FALLBACK_NAME=
MODEL_FALLBACK_TIMEOUT_SECONDS=10
